# RandomChat — single root env file for ALL services in development.
# Copy to .env (gitignored): `cp .env.example .env`, then replace every "dev-only" secret
# (e.g. `openssl rand -hex 32`). Real environment variables override values from .env.
# Every variable must also be documented in CONTEXT.md §8.

# --- Common -------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL (docker: user/password/db = app/app/app) ------------------------------
# Host port of the Docker Postgres. Change it (and both URLs) if 5432 is already taken,
# e.g. by a Homebrew/Postgres.app server.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@localhost:5432/app
DATABASE_URL_TEST=postgresql://app:app@localhost:5432/app_test

# --- Redis --------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Integration tests use a separate logical DB (flushed by tests).
REDIS_URL_TEST=redis://localhost:6379/15

# --- Visitor auth (api, gateway) ----------------------------------------------------
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_TTL_SECONDS=43200
# HMAC peppers: raw IPs / device IDs are only ever stored as HMAC-SHA256 hashes.
IP_HASH_PEPPER=dev-only-ip-pepper-change-me
DEVICE_HASH_PEPPER=dev-only-device-pepper-change-me
TOS_VERSION=2026-10-dev

# --- Cloudflare Turnstile (official always-pass TEST keys) --------------------------
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- TURN / STUN (coturn) -----------------------------------------------------------
# Shared HMAC secret between the API (mints credentials) and coturn (verifies them).
TURN_SECRET=dev-only-turn-secret-change-me
TURN_HOST=localhost
TURN_PORT=3478
TURN_CREDENTIAL_TTL_SECONDS=600
STUN_URLS=stun:localhost:3478
# IP advertised in relay candidates. 127.0.0.1 works for browsers on this machine;
# set your LAN IP (e.g. 192.168.1.20) to test from a phone on the same network.
TURN_EXTERNAL_IP=127.0.0.1

# --- Service ports & CORS -----------------------------------------------------------
# Listen address for the API (0.0.0.0 = reachable from LAN devices; 127.0.0.1 = this machine only).
API_HOST=0.0.0.0
API_PORT=4000
# Listen address for the gateway (same meaning as API_HOST).
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=4001
# Unique per gateway process; defaults to hostname+port when unset.
# GATEWAY_NODE_ID=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Reverse proxies whose X-Forwarded-For is trusted: empty = none (dev), a hop count, or a
# comma list of proxy IPs/CIDRs. "true" is rejected (anyone could spoof their IP).
TRUST_PROXY=

# --- Browser-exposed (web, admin) ---------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4001
# true = hide user IPs from peers: all media goes through TURN.
NEXT_PUBLIC_FORCE_TURN_RELAY=false

# --- Object storage (MinIO, S3-compatible) ------------------------------------------
# Also used as the MinIO root user/password by docker-compose (password >= 8 chars).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=randomchat
S3_SECRET_KEY=dev-only-minio-secret-change-me
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_FRAMES=frames

# --- Matchmaking (gateway) ----------------------------------------------------------
INTEREST_FALLBACK_MS=5000
RECENT_PAIR_TTL_MS=60000

# --- Worker (BullMQ) ---------------------------------------------------------------
WORKER_CONCURRENCY=10

# --- Dev toggles --------------------------------------------------------------------
# Honored only when NODE_ENV=development.
RATE_LIMIT_DISABLED=false

# --- Admin (Part 9) -----------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@randomchat.local
SEED_ADMIN_PASSWORD=dev-only-admin-password-change-me
ADMIN_SESSION_TTL_SECONDS=28800
