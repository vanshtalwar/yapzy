# Janus core configuration (rendered by entrypoint.sh). Only what we use is set; see the
# upstream janus.jcfg.sample (v1.4.3) for every option.
general: {
	configs_folder = "/opt/janus/etc/janus"
	plugins_folder = "/opt/janus/lib/janus/plugins"
	transports_folder = "/opt/janus/lib/janus/transports"
	events_folder = "/opt/janus/lib/janus/events"
	loggers_folder = "/opt/janus/lib/janus/loggers"
	log_to_stdout = true
	debug_level = ${JANUS_DEBUG_LEVEL}
	debug_timestamps = true
	debug_colors = false
	server_name = "${JANUS_NODE_ID}"

	# Every Janus API request (create, attach, message, trickle, keepalive) must carry a token
	# signed by the gateway: "<expiry>,janus,janus.plugin.videoroom,<nonce>:<HMAC-SHA256>".
	token_auth = true
	token_auth_secret = "${JANUS_TOKEN_SECRET}"
	token_auth_hash = "sha256"
	# Admin API (port 7188, backend only).
	admin_secret = "${JANUS_ADMIN_SECRET}"
	# Don't answer "info" without a token, and never list dependency versions.
	restrict_info_api = true
	hide_dependencies = true

	# Clients send keepalives every 25 s. After a WebSocket drop a client may "claim" its
	# session again for 20 s (its PeerConnections keep running meanwhile).
	session_timeout = 60
	reclaim_session_timeout = 20
	candidates_timeout = 45

	# Nothing is ever recorded; keep the plugin away from system folders anyway.
	protected_folders = [
		"/bin", "/boot", "/dev", "/etc", "/lib", "/lib64", "/proc", "/sbin", "/sys", "/usr", "/var",
		"/opt/janus"
	]
}

certificates: {
	# No certificate configured: Janus generates a self-signed one for DTLS at start, which
	# is fine for WebRTC (peers verify the fingerprint from the SDP, not a CA chain).
}

media: {
	ipv6 = false
	rtp_port_range = "${JANUS_RTP_PORT_RANGE}"
	dtls_mtu = 1200
	no_media_timer = 1
	slowlink_threshold = 4
	twcc_period = 200
}

nat: {
	# Docker (and most cloud hosts) put Janus behind a 1:1 NAT: advertise the public address
	# instead of the container address. Full ICE (not ICE-Lite) as Janus recommends behind NAT.
	nat_1_1_mapping = "${JANUS_PUBLIC_IP}"
	keep_private_host = false
	full_trickle = false
	ice_lite = false
	ice_tcp = false
	# Browsers and Janus are never on the same LAN in production; skip slow mDNS lookups.
	ignore_mdns = true
}

plugins: {
}

transports: {
}

loggers: {
}

events: {
	broadcast = false
}
