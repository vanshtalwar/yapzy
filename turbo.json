{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env.example"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate", "^generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["transit", "generate", "^generate"]
    },
    "typecheck": {
      "dependsOn": ["transit", "generate", "^generate"]
    },
    "test": {
      "dependsOn": ["transit", "generate", "^generate"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["generate", "^generate"]
    },
    "clean": {
      "cache": false
    }
  }
}
