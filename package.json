{
  "name": "randomchat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d --wait postgres redis coturn minio && docker compose --env-file .env -f infra/docker/docker-compose.yml run --rm minio-init",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml logs -f --tail=100",
    "infra:ps": "docker compose --env-file .env -f infra/docker/docker-compose.yml ps",
    "infra:reset": "docker compose --env-file .env -f infra/docker/docker-compose.yml down -v --remove-orphans",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate": "pnpm --filter @app/db migrate",
    "db:migrate:test": "pnpm --filter @app/db migrate:test",
    "db:deploy": "pnpm --filter @app/db migrate:deploy",
    "db:reset": "pnpm --filter @app/db reset",
    "db:seed": "pnpm --filter @app/db seed",
    "db:studio": "pnpm --filter @app/db studio"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
